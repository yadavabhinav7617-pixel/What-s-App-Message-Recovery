# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Cluster URL for production/Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/notifyvault?retryWrites=true&w=majority

# Security & JWT Token Secrets
JWT_SECRET=replace_with_secure_random_secret_key_123

# CORS Configuration (* for all origins or comma-separated list of web dashboard origins)
CORS_ORIGIN=*

# Initial Admin Bootstrap Credentials (Used on first deployment)
ADMIN_INITIAL_SETUP_SECRET=replace_with_secure_setup_secret
SUPER_ADMIN_EMAIL=admin@notifyvault.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
